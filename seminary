#!/bin/zsh
# Seminary command menu — pick a script by number, ye olde sysadmin style.
# Grouped by what you're doing. To add an item: add a line to MENU, then a
# case in run_action with the same key.

source "$HOME/.zshrc" >/dev/null 2>&1

if [[ ! -t 0 ]]; then
  echo "This menu is interactive — run it directly in a terminal."
  exit 1
fi

VAULT="$HOME/Notes/Obsidian/Hydralisk"

# "## Section" starts a group; "key|label" is a menu item. Items are numbered in order.
MENU=(
  "## Write"
  "new-paper|New paper (seminary-new)"
  "new-review|New book review (seminary-new-review)"
  "import|Import DOCX back to Markdown (seminary-import)"

  "## Check & clean up"
  "refs|Bible book abbr + hyphens -> en-dashes"
  "refs-latest|Bible book abbr + hyphens -> en-dashes · most recent"
  "wc|Word count check (sem-wc)"
  "wc-latest|Word count check · most recent"
  "wc-cover|Word count check minus cover page (sem-cover-wc)"

  "## Build DOCX"
  "build|Build DOCX from a paper (seminary-build)"
  "build-latest|Most recent paper or review · USE FOR FINAL SUBMISSION"
  "build-h1|Most recent · H1 breaks · readability only"
  "build-review|Most recent BOOK REVIEW"

  "## Study"
  "quiz-latest|Practice quiz · most recent quiz (semquiz)"
  "quiz-pick|Practice quiz · choose class and quiz"
  "quiz-new|New practice quiz from a PDF (seminary-quiz-from-pdf)"
  "pdf2md|Convert a PDF to Markdown notes (seminary-pdf2md)"

  "## Obsidian"
  "banner|Card banner for the Kanban board (card-banners.py)"
)

# Colors only when the terminal supports them.
if [[ -n "$TERM" && "$TERM" != dumb ]] && (( $(tput colors 2>/dev/null || echo 0) >= 8 )); then
  B=$'\e[1m' D=$'\e[2m' C=$'\e[36m' R=$'\e[0m'
else
  B="" D="" C="" R=""
fi

draw_menu() {
  clear
  echo "=========================================="
  echo "          SEMINARY COMMAND MENU"
  echo "=========================================="
  keys=()
  local entry n=0
  for entry in "${MENU[@]}"; do
    if [[ $entry == "## "* ]]; then
      echo ""
      echo "${B}${C}${entry#\#\# }${R}"
    else
      (( n++ ))
      keys+=("${entry%%|*}")
      printf "  ${D}%2d)${R} %s\n" $n "${entry#*|}"
    fi
  done
  echo ""
}

latest_paper() {
  # -L because $SEMINARY is a symlink; find will not descend it otherwise.
  find -L "$SEMINARY" -name "*_Louthan_*.md" -type f -print0 | xargs -0 ls -t 2>/dev/null | head -1
}

pick_class() {
  # Sets $classdir. Returns 1 if there's nothing to pick or the pick is invalid.
  local classdirs=() d
  for d in "$SEMINARY"/*/; do
    classdirs+=("$(basename "${d%/}")")
  done
  if [[ ${#classdirs[@]} -eq 0 ]]; then
    echo "No class subdirectories found in $SEMINARY."
    return 1
  fi
  echo ""
  echo "Which class?"
  PS3="Class #: "
  select classdir in "${classdirs[@]}"; do
    if [[ -z "$REPLY" || "$REPLY" -lt 1 || "$REPLY" -gt ${#classdirs[@]} ]]; then
      echo "Invalid selection."
      return 1
    fi
    break
  done
}

run_action() {
  case $1 in
    new-paper)
      read "classcode?Class code (e.g. BI11): "
      read "title?Paper title: "
      seminary-new "$classcode" "$title"
      ;;
    new-review)
      read "classcode?Class code (e.g. BI13): "
      read "title?Book short title (e.g. Carson Exegetical Fallacies): "
      seminary-new-review "$classcode" "$title"
      ;;
    import)
      read "file?DOCX file to import: "
      seminary-import "$file"
      ;;
    refs)
      read "file?Paper .md file: "
      seminary-fix-refs "$file"
      ;;
    refs-latest)
      ~/bin/semfixrefs-latest.sh
      ;;
    wc)
      read "file?Paper .md file: "
      read "pages?Target page count [1]: "
      pages=${pages:-1}
      sem-wc "$file" "$pages"
      ;;
    wc-latest)
      LATEST_MD=$(latest_paper)
      if [[ -z "$LATEST_MD" ]]; then
        echo "No paper .md file found."
      else
        echo "Latest paper: $(basename "$LATEST_MD")"
        read "pages?Target page count [1]: "
        pages=${pages:-1}
        sem-wc "$LATEST_MD" "$pages"
      fi
      ;;
    wc-cover)
      read "file?Paper .md file: "
      read "pages?Total page count including cover [2]: "
      pages=${pages:-2}
      sem-cover-wc "$file" "$pages"
      ;;
    build)
      read "file?Paper .md file: "
      seminary-build "$file"
      ;;
    build-latest)
      ~/bin/sembuild-latest.sh
      ;;
    build-h1)
      ~/bin/sembuild-latest-h1-breaks.sh
      ;;
    build-review)
      # Forces the book-review pipeline (no cover page) regardless of whether
      # the file carries a bibref: key -- picking this option is the override.
      LATEST_MD=$(latest_paper)
      if [[ -z "$LATEST_MD" ]]; then
        echo "No paper .md file found."
      else
        echo "Latest: $(basename "$LATEST_MD")"
        seminary-build-review "$LATEST_MD"
      fi
      ;;
    quiz-latest)
      # Excludes *.history.json (score logs) so it only picks up actual quizzes.
      LATEST_QUIZ=$(find -L "$SEMINARY" -name "*.json" -type f ! -name "*.history.json" -print0 \
        | xargs -0 ls -t 2>/dev/null | head -1)
      if [[ -z "$LATEST_QUIZ" ]]; then
        echo "No quiz .json file found."
      else
        echo "Latest quiz: $(basename "$LATEST_QUIZ")"
        seminary-quiz "$LATEST_QUIZ"
      fi
      ;;
    quiz-pick)
      pick_class || return
      # Excludes *.history.json (score logs) so it only picks up actual quizzes.
      local quizzes=() f
      while IFS= read -r -d '' f; do
        quizzes+=("$f")
      done < <(find -L "$SEMINARY/$classdir" -maxdepth 1 -iname "*.json" ! -iname "*.history.json" -print0 | sort -z)
      if [[ ${#quizzes[@]} -eq 0 ]]; then
        echo "No quiz JSON files found in $classdir."
        return
      fi
      echo ""
      echo "Which quiz?"
      PS3="Quiz #: "
      select quizname in "${quizzes[@]:t}"; do
        if [[ -z "$REPLY" || "$REPLY" -lt 1 || "$REPLY" -gt ${#quizzes[@]} ]]; then
          echo "Invalid selection."
          return
        fi
        seminary-quiz "${quizzes[$REPLY]}"
        break
      done
      ;;
    quiz-new)
      pick_class || return
      local pdfs=() f pdf
      while IFS= read -r -d '' f; do
        pdfs+=("$f")
      done < <(find -L "$SEMINARY/$classdir" -maxdepth 1 -iname "*.pdf" -print0 | sort -z)
      if [[ ${#pdfs[@]} -eq 0 ]]; then
        echo "No PDFs found in $classdir."
        return
      fi
      echo ""
      echo "Which PDF?"
      PS3="PDF #: "
      select pdfname in "${pdfs[@]:t}"; do
        if [[ -z "$REPLY" || "$REPLY" -lt 1 || "$REPLY" -gt ${#pdfs[@]} ]]; then
          echo "Invalid selection."
          return
        fi
        pdf="${pdfs[$REPLY]}"
        break
      done
      read "output?Output quiz JSON [default: alongside PDF, <PdfBasename>_Quiz.json]: "
      if [[ -z "$output" ]]; then
        seminary-quiz-from-pdf "$pdf"
      else
        seminary-quiz-from-pdf "$pdf" "$output"
      fi
      ;;
    pdf2md)
      seminary-pdf2md
      ;;
    banner)
      # Cover banners for Writing & Studying.base cards. The script lives in the
      # vault because it writes to the vault's Images/ folder.
      local cats=(seminary ot nt gospel)
      echo "Category?  seminary = dark grey · ot = dark blue · nt = dark red · gospel = dark purple"
      PS3="Category #: "
      select cat in "${cats[@]}"; do
        if [[ -z "$cat" ]]; then
          echo "Invalid selection."
          return
        fi
        break
      done
      read "title?Title (e.g. Romans): "
      [[ -z "$title" ]] && { echo "A title is required."; return; }
      local slug=$(print -r -- "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//')
      read "name?File name part [$slug]: "
      name=${name:-$slug}
      read "subtitle?Subtitle (optional, e.g. Theologicus): "
      python3 -I "$VAULT/Scripts/card-banners.py" "$cat" "$name" "$title" "$subtitle" || return
      local line="image: \"[[Images/card-$cat-$name.svg]]\""
      print -rn -- "$line" | pbcopy && echo "Copied to clipboard: $line"
      ;;
    *)
      echo "Invalid option."
      ;;
  esac
}

while true; do
  draw_menu
  read "choice?Choose an option (q to quit): " || exit 0
  case $choice in
    q|Q)
      echo "Goodbye."
      exit 0
      ;;
    <->)
      if (( choice >= 1 && choice <= ${#keys[@]} )); then
        echo ""
        run_action "${keys[$choice]}"
      else
        echo "Invalid option."
      fi
      ;;
    *)
      echo "Invalid option."
      ;;
  esac

  echo ""
  # On EOF (stdin exhausted) exit instead of silently redrawing the menu.
  read "?Press Enter to return to menu..." || exit 0
done
